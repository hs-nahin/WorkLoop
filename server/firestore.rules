rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Tasks (top-level) ──────────────────────────────────
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      // Sub-tasks subcollection
      match /subtasks/{subtaskId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Discussion messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null;
      }

      // Attachments subcollection
      match /attachments/{attachmentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Announcements ──────────────────────────────────────
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      match /readBy/{readerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // ── Roles & Permissions ────────────────────────────────
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /rolePermissions/{roleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /userPermissions/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Audit Logs ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ── Company Config ─────────────────────────────────────
    match /company/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Task Templates ─────────────────────────────────────
    match /taskTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
